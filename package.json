{
  "name": "poke-anime-tactical-simulator",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "test": "node --test tests/combat.test.js",
    "test:browser": "playwright test",
    "bake:showmotion": "node scripts/bake-showmotion.mjs",
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "start": "node server/index.js",
    "server": "node --watch server/index.js",
    "test:pvp": "node --test tests/pvp.test.js",
    "test:production": "npm run build && node scripts/smoke-production.mjs && playwright test --config=playwright.production.config.js"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@vitejs/plugin-react": "^4.3.4",
    "vite": "^6.0.7"
  },
  "engines": {
    "node": ">=22"
  }
}
